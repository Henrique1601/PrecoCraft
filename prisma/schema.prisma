generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoreType {
  MERCADO_LIVRE
  AMAZON
  ALIEXPRESS
  KABUM
  TIKTOK_SHOP
}

model List {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String       @id @default(cuid())
  listId      String
  list        List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  name        String
  notes       String?
  targetPrice Decimal?     @db.Decimal(10, 2)
  purchased   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  offers      StoreOffer[]

  @@index([listId])
}

model StoreOffer {
  id                String    @id @default(cuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  store             StoreType
  sellerName        String?
  url               String
  titleSnapshot     String?
  basePrice         Decimal   @db.Decimal(10, 2)
  previousBasePrice Decimal?  @db.Decimal(10, 2)
  lowestPriceSeen   Decimal?  @db.Decimal(10, 2)
  installmentPrice  Decimal?  @db.Decimal(10, 2)
  shippingCost      Decimal   @default(0) @db.Decimal(10, 2)
  discountAmount    Decimal   @default(0) @db.Decimal(10, 2)
  cashbackAmount    Decimal   @default(0) @db.Decimal(10, 2)
  inStock           Boolean   @default(true)
  sourceMode        String    @default("MANUAL") // "AUTO" | "BOOKMARKLET" | "MANUAL"
  lastCheckedAt     DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([productId])
  @@index([productId, store])
}
